# BountyFi App Environment Variables

# Mock Data Configuration
# Set to 'true' to use mock data instead of real API calls
# Set to 'false' or leave unset to use real backend API
EXPO_PUBLIC_USE_MOCK_API=false

# Supabase Configuration (used when mock mode is disabled)
# Get anon key from: Supabase Dashboard → Project Settings → API → anon public (long JWT starting with eyJ...)
# Required for Edge Functions (get_tasks, ensure_user, etc.); wrong key causes 401 Unauthorized.
# EXPO_PUBLIC_SUPABASE_URL=https://cguqjaoeleifeaxktmwv.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# EXPO_PUBLIC_WS_URL=wss://cguqjaoeleifeaxktmwv.supabase.co/realtime/v1
