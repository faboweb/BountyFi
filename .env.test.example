# Test Environment Variables
# Copy this to .env.test and update as needed

# Local Supabase (Default for tests)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# E2E Infrastructure Ports (from global memory)
# DB_PORT=5433
# SERVER_PORT=5004
# ANVIL_PORT=8545

# RPC for Local/Test networks
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Verification agent: set MOCK_AGENT=true to skip AI (verify_semantic) and chain (submitAIScore)
# Use for local/e2e tests. Set via: supabase secrets set MOCK_AGENT=true
# MOCK_AGENT=true
